# =============================================================================
# SmartMail Configuration Template (.env.example)
# =============================================================================
# Copy this file to .env and fill in your real values.
# NEVER commit your actual .env file to Git or version control!
#
# All external providers are completely OPTIONAL.
# The application runs fully functional in offline deterministic mode
# if no API keys are provided.
# =============================================================================

# --- Optional Web Search Provider (Tavily) ---
# Used for discovering company official websites and recent engineering evidence.
# Free tier: typically 1,000 searches/month.
# Sign up at: https://tavily.com/
TAVILY_API_KEY=
TAVILY_TIMEOUT_SECONDS=10

# --- Optional Primary LLM Provider (Google Gemini) ---
# Used for structured analysis of public company evidence.
# Free tier: Available via Google AI Studio (e.g. gemini-2.0-flash, gemini-1.5-flash).
# Free tier limits: typically 15 RPM, 1500 RPD depending on current Google terms.
# Sign up at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=15

# --- Optional Fallback LLM Provider (Groq) ---
# Used as secondary fallback if Gemini encounters rate limits or errors.
# Free tier available at: https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=15

# --- Privacy & Data Sharing Controls ---
# CRITICAL SAFEGUARD:
# When set to 'false' (DEFAULT), your CV, candidate name, education, and projects
# are NEVER sent to any external model provider. LLMs are used ONLY to extract
# technical information from public company text, and personalization is combined
# locally on your machine.
#
# Set to 'true' ONLY if you explicitly consent to passing your candidate skills
# and projects to external LLMs for drafting.
SMARTMAIL_SHARE_CV_WITH_EXTERNAL_LLM=false

# --- App Settings ---
# LOG_LEVEL=INFO
